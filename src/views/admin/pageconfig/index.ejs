<script>
    // global scope
    const modalEl = document.querySelector('#chooseImageModal');
    const modal = new bootstrap.Modal(modalEl);
    const modalVideoEl = document.querySelector('#chooseVideoModal');
    const modalVideo = new bootstrap.Modal(modalVideoEl);
    var groupTarget = null;
    var videoTarget = null;
    var fb_customer = [];
    const btnAddCustomer = document.getElementById('btnAddCustomer');
    const customersContainer = document.querySelector('.customers-container');
    const template = document.getElementById('customerTemplate').innerHTML;

    //
    function openModal() {
        modal.show();
    }
    function closeModal() {
        modal.hide();
    }
    // mo modal choose img
    document.querySelectorAll('.cta-choose-img').forEach((el) => {
        el.addEventListener('click', function (ev) {
            openModal();
            // console.log(ev.target);
            // console.log(el.closest('.preview-wrapper img'));
            groupTarget = this;
        });
    });
    // mo modal choose video
    document.querySelector('#s_whychooseus .cta-choose-video').addEventListener('click', function (ev) {
            modalVideo.show();
            videoTarget = this;
        });
    // Thêm khách hàng mới
    btnAddCustomer.addEventListener('click', () => {
            const wrapper = document.createElement('div');
            wrapper.innerHTML = template.trim();
            const card = wrapper.firstElementChild;

            // Xóa card
            card.querySelector('.remove-card').addEventListener('click', () => card.remove());
            customersContainer.appendChild(card);
            // 🟢 Thêm đoạn này để gắn lại sự kiện cho các nút mới
            card.querySelectorAll('.cta-choose-img').forEach((el) => {
                el.addEventListener('click', function (ev) {
                    openModal();
                    groupTarget = this;
                });
            });
        });
    // 
    // get data
    // const btnGetData = document.getElementById('btnGetData');
    // btnGetData.addEventListener('click', () => {
