<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Admin dashboard</title>
        <link rel="stylesheet" href="/libs/css/sweetalert2.min.css" />
        <link rel="stylesheet" href="/libs/css/bootstrap.min.css" />
        <!--  -->
        <script src="/libs/js/jquery-3.7.1.js"></script>
        <script src="/libs/js/bootstrap.bundle.min.js"></script>
        <script src="/libs/js/sweetalert2.all.min.js"></script>
        <!-- text editor tinymce  -->
        <!-- fontawesome v7. -->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
            integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <!--  -->
        <link rel="stylesheet" href="/css/adminstyle.css" />
    </head>
    <body>
        <div id="sidebar" class="sidebar">
            <div class="logo" id="toggleBtn">
                <a href="#!">
                    <span class="logo-icon">⚙️</span>
                    <span class="logo-text">AccessRace</span>
                </a>
            </div>
            <ul>
                <a href="/admin/dashboard">
                    <li><i>🏡</i><span>Home</span></li>
                </a>

                <a href="/admin/page-config">
                    <li><i>📄</i><span>Page setting</span></li>
                </a>
                <a href="/admin/image">
                    <li><i>🖼️</i><span>Gallery</span></li>
                </a>
                <a href="/admin/video">
                    <li><i>📽️</i><span>Gallery</span></li>
                </a>
                <a href="/admin/auth/logout">
                    <li style="background-color: #2e2e44" class="logout"><i>🔒</i><span>Logout</span></li>
                </a>
            </ul>
        </div>
        <div class="main">
            <!-- <button  class="btn btn-secondary">⚓</button> -->
            <%- include('../admin/partials/header.ejs')%>
            <div class="main-container"><%- body%></div>
            <%- include('../admin/partials/footer.ejs')%>
        </div>
        <!-- ========== script -->
        <!-- <script src="/js/admin.js"></script> -->
        <script>
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('toggleBtn');
            toggleBtn.addEventListener('click', () => {
                sidebar.classList.toggle('collapsed');
            });
            //My notification
            function myNotification(mess, icon, position = 'center', time = 2000) {
                Swal.fire({
                    title: mess,
                    icon: icon,
                    position: position,
                    showConfirmButton: false,
                    timer: time,
                });
            }
        </script>
    </body>
</html>
