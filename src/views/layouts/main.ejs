<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>ToppiLife</title>
        <!-- Cơ bản cho SEO -->
        <meta name="description" content="ToppiLife mang đến giải pháp hỗ trợ sức khỏe toàn diện giúp giảm đau nhức, cải thiện giấc ngủ và nâng cao chất lượng cuộc sống cho người bận rộn và người lớn tuổi.">
        <meta name="keywords" content="ToppiLife, giảm đau nhức, máy massage, chăm sóc sức khỏe tại nhà, cải thiện giấc ngủ, thư giãn, phục hồi năng lượng">
        <!-- <meta name="robots" content="index, follow"> -->
        <!-- <link rel="canonical" href="https://www.toppilife.vn/"> -->
        <!-- <link rel="icon" href="/favicon.ico" type="image/x-icon"> -->

        <!-- Open Graph: Facebook, LinkedIn, Zalo -->
        <meta property="og:title" content="ToppiLife - Giải pháp chăm sóc sức khỏe & giấc ngủ tại nhà">
        <meta property="og:description" content="Không còn đau nhức, ngủ ngon hơn mỗi ngày cùng ToppiLife. Giải pháp hỗ trợ sức khỏe tiện lợi, hiện đại ngay tại nhà.">
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://www.toppilife.vn/">
        <meta property="og:image" content="https://www.toppilife.vn/seo/preview-image.png">
        <meta property="og:site_name" content="ToppiLife">
        <meta property="og:locale" content="vi_VN">

        <!-- Thẻ hỗ trợ hiển thị tốt trên Zalo -->
        <meta name="zalo:title" content="ToppiLife - Giải pháp sức khỏe thông minh tại nhà">
        <meta name="zalo:description" content="ToppiLife giúp giảm đau nhức, cải thiện giấc ngủ và phục hồi năng lượng mỗi ngày.">
        <meta name="zalo:image" content="https://www.toppilife.vn/seo/preview-image.png">

        <!-- Zalo (dùng Open Graph) -->
        <!-- Zalo đọc og:title, og:description, og:image, og:url giống Facebook -->
        <link rel="stylesheet" href="css/main.css" />
        <link rel="stylesheet" href="css/style.css" />
        <!-- jquery -->
        <script src="libs/js/jquery-3.7.1.js"></script>
        <!-- Font Awesome CDN -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
        <!-- swiper -->
        <link rel="stylesheet" href="libs/css/swiper-bundle.min.css" />
        <script src="libs/js/swiper-bundle.min.js" defer></script>
    </head>
    <body>
        <%- include('../partials/header.ejs')%>
        <main><%- body%></main>
        <%- include('../partials/footer.ejs')%>
    </body>
</html>
