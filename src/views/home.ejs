<section
    id="whychooseus"
    class="bg-[linear-gradient(180deg,#f0f8f0_0%,#f3fbfb_100%)] lg:mx-[2%] lg:rounded-[30px] lg:mt-[30px]"
>
    <div class="main-container">
        <h2 class="title font-bold text-[32px] leading-10 tracking-normal text-center pt-8 mb-8">
            <!-- Điều gì khiến ToppiLife được nhiều dân văn phòng lựa chọn -->
             <%= (pc && pc.whychooseus) ? pc.whychooseus?.title : 'Điều gì khiến ToppiLife được nhiều dân văn phòng lựa chọn' %>
        </h2>
        <!-- video -->
        <div class="flex justify-center">
            <div
                style="position: relative"
                class="h-[250px] mb-[25px] w-full p-[5px] rounded-2xl bg-gradient-to-r from-[#08E9FC] via-[#0464D5] to-[#564CDD] animate-gradient inline-block lg:min-h-[690px] lg:w-[90%]"
            >
                <div class="relative rounded-[14px] bg-white w-full h-full overflow-hidden z-10">
                    <!-- Video /vids/women_morning.mp4-->
                    <video
                        id="myVideo"
                        src="<%=(pc&&pc.whychooseus)?(`/uploads/vids/`+pc.whychooseus?.video):'/vids/women_morning.mp4'%>" 
                        class="w-full h-full object-cover rounded-[14px]"
                        controls
                        playsinline
                        poster="/imgs/hero-img-primary.png"
                    ></video>

                    <!-- Nút Play -->
                      <!-- Nút Play pulse overlay -->
      <div
        id="playOverlay"
        class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 cursor-pointer"
      >
        <div class="bg-white rounded-full w-17 h-17 flex items-center justify-center shadow-lg animate-pulse over:scale-110 transition-transform duration-300">
          <i class="fa-solid fa-play text-[#579fc9] text-3xl"></i>
        </div>
      </div>
      <script>
        const video = document.getElementById('myVideo');
const overlay = document.getElementById('playOverlay');

overlay.addEventListener('click', () => {
  video.play();
  overlay.style.display = 'none'; // ẩn overlay sau khi nhấn
});

      </script>
                    <!-- <button id="play-vid" class="transition-opacity duration-300 ease-in-out text-[70px]" style="position: absolute; top:50%; left: 50%; transform: translate(-50%, -50%); padding: 5px 20px; "><i class="fa-solid fa-play text-[#579fc9]"></i></button> -->
                </div>
            </div>
        </div>

