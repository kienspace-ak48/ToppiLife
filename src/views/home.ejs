<script>
    // global scope
    let benefitSwiperInstance = null;
    let solutionSwiperInstance = null;
    let saleEndTimeServer ='<%=(pc.voucher)?pc.voucher?.end_date:"" %>'
    function initBenefitSwiper() {
        if (window.innerWidth < 1024 && !benefitSwiperInstance) {
            benefitSwiperInstance = new Swiper('.benefit_swiper', {
                loop: true,
                autoplay: {
                    delay: 5500,
                    disableOnInteraction: false,
                },
                slidesPerView: 1,
                spaceBetween: 20,
                scrollbar: {
                    el: '.swiper-scrollbar',
                },
            });
        } else if (window.innerWidth >= 1024 && benefitSwiperInstance) {
            benefitSwiperInstance.destroy(true, true);
            benefitSwiperInstance = null;
        }
    }
    function initSolutionSwiper() {
        if (window.innerWidth < 1024 && !solutionSwiperInstance) {
            solutionSwiperInstance = new Swiper('.solution_swiper', {
                direction: 'horizontal',
                loop: true,
                scrollbar: {
                    el: '.solution_swiper .swiper-scrollbar',
                },
                slidesPerView: 1,
                spaceBetween: 10,
                autoplay: {
                    delay: 6000,
                    disableOnInteraction: false,
                },
            });
        } else if(window.innerWidth >=1024 && solutionSwiperInstance){
            solutionSwiperInstance.destroy(true, true);
            solutionSwiperInstance = null;
        }
    }
    initSolutionSwiper();
    initBenefitSwiper();
    window.addEventListener('resize', () => {
        initBenefitSwiper();
        initSolutionSwiper();
    });
    //
    const swiper = new Swiper('.swiper.story_swiper', {
        direction: 'horizontal', // hoặc 'vertical'
        loop: true, // nếu muốn chạy lặp lại
        scrollbar: {
            el: '.story_swiper .swiper-scrollbar',
        },
        slidesPerView: 1, // số slide hiển thị đồng thời
        spaceBetween: 10, // khoảng cách giữa slides (px)
        autoplay: {
            delay: 6000,
            disableOnInteraction: false,
        },
    });

    //Countting down
    
  // 👉 đặt ngày hết hạn (ví dụ 5/11/2025 23:59:59)
  const saleEndTime = new Date(saleEndTimeServer).getTime();

  const countdown = setInterval(() => {
    const now = new Date().getTime();
    const distance = saleEndTime - now;
    // Tính toán ngày - giờ - phút - giây
    let days = Math.floor(distance / (1000 * 60 * 60 * 24));
    let hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    let minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    let seconds = Math.floor((distance % (1000 * 60)) / 1000);

    // Hiển thị
    // document.getElementById("countdown").innerHTML =
    //   `${days}d ${hours}h ${minutes}m ${seconds}s`;
      $("#countdown_date").text(days);
      $("#countdown_hour").text(hours);
      $("#countdown_minute").text(minutes);
      $("#countdown_second").text(seconds)
    // Hết hạn → hiển thị "Hết giờ"
    if (distance < 0) {
      clearInterval(countdown);
    //   document.getElementById("countdown").innerHTML = "🎉 Hết khuyến mãi 🎉";
    $("#countdown_date").text('00');
      $("#countdown_hour").text('00');
      $("#countdown_minute").text('00');
      $("#countdown_second").text('00')
    }
  }, 1000);

</script>
