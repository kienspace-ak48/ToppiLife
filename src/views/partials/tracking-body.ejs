<% 
  const gtmId = (pc && pc.pageinfo && pc.pageinfo.gtm_id) ? String(pc.pageinfo.gtm_id).trim() : '';
  const metaPixelId = (pc && pc.pageinfo && pc.pageinfo.meta_pixel_id) ? String(pc.pageinfo.meta_pixel_id).trim() : '';
%>
<% if (gtmId) { %>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= encodeURIComponent(gtmId) %>"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
<% } %>
<% if (metaPixelId) { %>
<noscript><img height="1" width="1" style="display:none"
src="https://www.facebook.com/tr?id=<%= encodeURIComponent(metaPixelId) %>&ev=PageView&noscript=1"
alt="" /></noscript>
<% } %>
